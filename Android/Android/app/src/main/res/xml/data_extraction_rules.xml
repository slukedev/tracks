<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and device transfers from Android 12. Secrets stay out: their key never leaves this
     device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tracks-secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tracks-secrets.xml" />
    </device-transfer>
</data-extraction-rules>
